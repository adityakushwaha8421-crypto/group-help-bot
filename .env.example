# ===================== Core =====================
APP_ENV=production
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
API_HOST=0.0.0.0
API_PORT=8080

# ===================== OpenAI =====================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=120
# Use AI to classify Betix replies that regex rules cannot classify (true/false)
AI_CLASSIFY_UNKNOWN_BETIX_REPLIES=true
# Extract keyframes from payment videos (needs ffmpeg on PATH) and send them to the model
VIDEO_KEYFRAMES_ENABLED=true
VIDEO_KEYFRAME_COUNT=4

# ===================== Database / Queue =====================
DATABASE_URL=postgresql+asyncpg://verifier:verifier@localhost:5432/verifier
REDIS_URL=redis://localhost:6379/0
# true = run background jobs inside the bot process without Redis (development only)
INLINE_JOBS=false

# ===================== Telegram (1/2): BOT API credentials — always required =====================
# One bot token from @BotFather. Used for the input bot, admin notifications and, in bot mode,
# posting to / monitoring the Betix group.
TELEGRAM_BOT_TOKEN=
# Telegram user IDs allowed to submit cases to the bot (comma separated). Empty = nobody.
ADMIN_TELEGRAM_USER_IDS=
# true = anyone may message the bot and becomes the customer of their own case; false = admins only (they
# forward customer messages; the case then belongs to the ORIGINAL sender of the forwarded evidence)
ALLOW_CUSTOMER_DIRECT_SUBMISSIONS=false
# Chat IDs that receive alerts and confirmations (comma separated)
ADMIN_NOTIFY_CHAT_ID=
# Messages from the same submitter within this window are grouped into the same open case
CASE_COLLECTION_WINDOW_MINUTES=30
# After the last incoming message, wait this long before processing (lets statement/video arrive)
CASE_DEBOUNCE_SECONDS=60
# Whether bank statement + video must be present before the case is processed (else screenshot+registration is enough)
# All four are REQUIRED before processing: payment screenshot, mobile number, bank statement (PDF), payment video
REQUIRE_ALL_EVIDENCE=true
# The first message of a case opens ONE collection window of this many seconds; then the case is checked
COLLECTION_SECONDS=5
# A forwarded batch arriving within this many seconds joins the collecting case even if the forward origins differ
BATCH_JOIN_SECONDS=30
# Regex used to recognise a registration/reference number in a plain text message (group 1 = value)
REGISTRATION_REGEX=^(?:reg(?:istration)?\.?(?:\s*(?:no\.?|number|#))?[:#\s]+)?([A-Za-z0-9][A-Za-z0-9\-_/]{3,39})$

# ===================== Telegram: Betix Pay support group =====================
# Numeric chat id of the Betix support group (e.g. -1001234567890). Preferred.
BETIX_GROUP_CHAT_ID=
# Optional @username of the group (used if chat id is empty)
BETIX_GROUP_USERNAME=
# How the evidence is POSTED: bot (Bot API, bot must be a member) | user (Telethon user session)
BETIX_POST_MODE=bot
# How the group is MONITORED: bot (bot must be admin OR privacy mode disabled) | user (Telethon)
BETIX_MONITOR_MODE=bot
# Human confirmation comes from ANY member of the Betix support group ("success", "confirmed", "done"…).
# Leave these EMPTY. They are an optional extra restriction only (non-empty = only these members count).
AUTHORIZED_BETIX_REVIEWER_IDS=
AUTHORIZED_BETIX_REVIEWER_USERNAMES=
# Verify the confirmer's group membership via the Bot API (getChatMember); falls back to message origin.
BETIX_VERIFY_MEMBERSHIP=true
BETIX_MEMBERSHIP_CACHE_MINUTES=10
# Our OWN accounts (besides the input bot, which is detected automatically): never a Betix confirmer.
OUR_TELEGRAM_IDS=
OUR_TELEGRAM_USERNAMES=
# Trusted Betix verification bot accounts (usernames without @, e.g. betixpay_cs_bot)
BETIX_SYSTEM_BOT_USERNAMES=betixpay_cs_bot
BETIX_SYSTEM_BOT_IDS=
# either = Betix system bot SUCCESS **or** a clear confirmation from any human member of the Betix group (default)
# strict = BOTH are required; monitor = alias of either
CONFIRMATION_MODE=either
# Caption placed on the screenshot (the Betix bot OCRs the screenshot and reads this caption)
BETIX_SCREENSHOT_CAPTION_TEMPLATE={betex_order_id}
# The follow-up message (a reply to our screenshot post). Keep it short.
BETIX_FOLLOWUP_TEXT=Any update?
# Bank statement + payment video in the Betix group, always as REPLIES to the screenshot post:
#   always = right after the screenshot (default) | on_request = only once Betix asks | never
BETIX_EXTRA_EVIDENCE_POLICY=always
# Regex identifying a Betex Pay / merchant order id in text (both in admin panel and Betix replies)
BETEX_ORDER_ID_REGEX=\bILLUN-\d{8,20}\b
# Regex identifying Betix platform order numbers in bot replies
BETIX_PLAT_ORDER_REGEX=\bPI[0-9a-z]{10,24}\b
# Only correlate un-threaded reviewer messages to a case by proximity within this window
BETIX_PROXIMITY_WINDOW_MINUTES=10

# ===================== Telegram (2/2): USER/CLIENT API credentials — optional =====================
# A separate credential set for a Telegram *user account* (MTProto, via Telethon). Only used when
# BETIX_POST_MODE=user and/or BETIX_MONITOR_MODE=user, i.e. when the Bot API cannot read or post in
# the Betix group. Safe to keep filled in bot mode; switching modes is then a one-line change.
# TELEGRAM_API_ID / TELEGRAM_API_HASH: https://my.telegram.org  ·  TELEGRAM_SESSION: python scripts/create_telegram_session.py
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# ===================== Follow-ups =====================
FOLLOWUP_SCHEDULE_MINUTES=120,480,1440,2880
# After follow-up #2, wait this long before escalating to you
ESCALATION_DELAY_MINUTES=480

# ===================== Illunise admin panel =====================
ILLUNISE_ADMIN_BASE_URL=https://illunise.in
ILLUNISE_ADMIN_USERNAME=
ILLUNISE_ADMIN_PASSWORD=
# auto = log in with credentials; manual = you log in once in a headed browser (python -m app.admin.login --manual)
ADMIN_AUTH_MODE=auto
ADMIN_HEADLESS=true
ADMIN_STORAGE_STATE_PATH=data/browser/illunise_state.json
ADMIN_SELECTORS_FILE=config/admin_selectors.yaml
ADMIN_NAV_TIMEOUT_MS=30000
# Save a screenshot + HTML of the orders page whenever parsing fails (helps fix selectors)
ADMIN_DEBUG_ARTIFACTS_DIR=data/browser/debug

# ===================== Order matching =====================
ORDER_MATCH_THRESHOLD=0.90
# If the best and second-best candidate scores are closer than this, the match is AMBIGUOUS
ORDER_MATCH_AMBIGUITY_GAP=0.10
# The Illunise order is created BEFORE the customer pays. Accept an order created between MIN and MAX
# minutes before the payment time (payment_time - order_created_time), with a clock-skew tolerance.
ORDER_TIME_MIN_BEFORE_PAYMENT=0
ORDER_TIME_MAX_BEFORE_PAYMENT=30
PAYMENT_TIME_TOLERANCE_MINUTES=3
PAYMENT_TIME_WINDOW_MINUTES=15
# The paid amount is "padded" (₹13,999.35 for a ₹14,000 order): allowed difference in currency units
ORDER_AMOUNT_TOLERANCE=1.00
# Gateway name shown by Illunise for Betix orders
BETIX_GATEWAY_NAME=BetixPay
COMPATIBLE_ORDER_STATUSES=pending,success,processing,paid,initiated,created
# Signal weights (normalised automatically): mobile, amount, created-before-payment, gateway, UTR, status
MATCH_WEIGHT_REGISTRATION=0.30
MATCH_WEIGHT_AMOUNT=0.25
MATCH_WEIGHT_TIME=0.20
MATCH_WEIGHT_GATEWAY=0.10
MATCH_WEIGHT_UTR=0.10
MATCH_WEIGHT_STATUS=0.05
MATCH_WEIGHT_UPI=0
MATCH_WEIGHT_PAYER=0

# ===================== Evidence storage =====================
EVIDENCE_DIR=data/evidence
EVIDENCE_RETENTION_DAYS=90
# Bot API cannot download files > 20 MB; larger files are forwarded by file_id only
EVIDENCE_MAX_DOWNLOAD_MB=20

# --- scaling knobs (defaults are fine for one Mac) ---
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
ADMIN_BROWSER_PAGES=3
AI_MAX_CONCURRENCY=6
OPENAI_MAX_RETRIES=4
INLINE_JOB_WORKERS=8
TG_GROUP_SEND_INTERVAL_SECONDS=3
TG_PRIVATE_SEND_INTERVAL_SECONDS=0.4
# BETIX_GROUP_CHAT_ID may list several groups, comma separated; the first is where new cases go
